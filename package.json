{
  "name": "@eliware/core",
  "version": "15.2.0",
  "type": "module",
  "description": "Core Networking Manager.",
  "keywords": [
    "core",
    "networking",
    "network-management",
    "routing",
    "configuration",
    "nodejs",
    "cli",
    "web"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./bin/core-cli.mjs",
  "bin": {
    "core-cli": "./bin/core-cli.mjs",
    "core-web": "./bin/core-web.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    "public/"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "build": "webpack --config webpack.config.mjs",
    "prebuild": "webpack-cli --version",
    "lighthouse": "lighthouse http://127.0.0.1:9300 --only-categories=performance,best-practices,seo,accessibility --output=json --output-path=artifacts/lighthouse.json --chrome-flags=--headless && node bin/pwa-audit.mjs",
    "screenshots": "node bin/screenshots.mjs",
    "puppeteer": "puppeteer browsers install chrome",
    "pack": "eliware-test --pack"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^15.0.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "lighthouse": "^13.6.0",
    "puppeteer": "^25.18.1"
  },
  "devDependencies": {
    "@eliware/test": "^15.2.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/core.git"
  },
  "homepage": "https://github.com/eliware/core#readme",
  "bugs": {
    "url": "https://github.com/eliware/core/issues"
  },
  "eliware": {
    "id": "E-9300",
    "apply": [
      "general",
      "application",
      "cli",
      "web",
      "npm-published"
    ]
  }
}
