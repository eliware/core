{
  "id": "/",
  "name": "Eliware Core Router Status",
  "short_name": "Core Status",
  "description": "Read-only health and deployment status for an Eliware Core router.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101b2d",
  "theme_color": "#101b2d",
  "orientation": "any",
  "icons": [
    { "src": "/icons/template.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/template-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/template-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/template-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/core-desktop.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Eliware Core desktop status dashboard"
    },
    {
      "src": "/screenshots/core-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Eliware Core mobile status dashboard"
    }
  ]
}
