# Optional. Defaults to 9300. Accepted values are integers from 1 through 65535.
# PORT=9300
# Optional. Defaults to 9301. Use a distinct value for each application instance when needed.
# WEBHOOK_PORT=9301
# Optional. Defaults to info. The value is passed to the logger.
# LOG_LEVEL=info
# Optional. Set the dashboard URL that alert recipients can open.
# CORE_DASHBOARD_URL=https://router.example/
# Required to enable signed GitHub push deployments.
# CORE_REPO_PATH=./router-config
# GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional. Send deployment and health notifications as Discord embeds.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me
# Optional. Defaults to main.
# CORE_GITHUB_BRANCH=main
# Optional. Assign a unique worker and process pair to each active application instance.
SNOWFLAKE_WORKER_ID=0
SNOWFLAKE_PROCESS_ID=0
# Comma-separated systemd units to check every five minutes.
# CORE_HEALTH_UNITS=example-router.service
